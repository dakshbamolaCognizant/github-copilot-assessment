{
  "name": "fintrack-api",
  "version": "1.0.0",
  "description": "FinTrack API - Expense Splitting and Transaction Management",
  "main": "dist/index.js",
  "directories": {
    "src": "src",
    "test": "src"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:expenses": "jest src/expenses",
    "test:transactions": "jest src/transactions",
    "test:all": "jest --coverage --detectOpenHandles",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "expense",
    "splitting",
    "fintech",
    "transaction",
    "balance"
  ],
  "author": "FinTrack Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "prisma": "^8.0.0-rc.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
